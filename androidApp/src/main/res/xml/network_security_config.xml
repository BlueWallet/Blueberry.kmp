<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Tor directory authorities and relay dirports serve consensus/microdescs over HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
