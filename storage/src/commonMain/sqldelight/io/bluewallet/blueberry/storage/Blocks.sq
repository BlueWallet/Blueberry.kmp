insert:
INSERT OR IGNORE INTO blocks (height, block_hash_internal_hex, block) VALUES (?, ?, ?);

insertIfMatched:
INSERT OR IGNORE INTO blocks (height, block_hash_internal_hex, block)
SELECT ?, ?, ?
WHERE EXISTS (
  SELECT 1 FROM matched_blocks
  WHERE height = ? AND block_hash_internal_hex = ?
);

changes:
SELECT changes();

count:
SELECT COUNT(*) AS n FROM blocks;

has:
SELECT 1 AS ok FROM blocks WHERE height = ?;

getMeta:
SELECT height, block_hash_internal_hex, length(block) AS nbytes FROM blocks WHERE height = ?;

getBlobChunk:
SELECT CAST(substr(block, CAST(? AS INTEGER), CAST(? AS INTEGER)) AS BLOB) AS chunk
FROM blocks
WHERE height = ?;

listNeedingParseHeights:
SELECT b.height
FROM blocks b
LEFT JOIN parsed_blocks p ON p.height = b.height
WHERE p.height IS NULL
ORDER BY b.height ASC
LIMIT ?;
